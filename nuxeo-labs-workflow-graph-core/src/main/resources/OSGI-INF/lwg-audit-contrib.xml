<?xml version="1.0"?>
<!--
  Audit of the transitions followed by graph workflows: the recorder (lwg-listener-contrib.xml) fires
  lwgWorkflowStepCompleted on the workflow instance each time a step completes. Workflow instances are audited even if
  they are system documents (ForceAudit facet added by the routing audit contribution).

  @since 2025.2
-->
<component name="nuxeo.labs.workflowgraph.audit">

  <require>org.nuxeo.audit.service.AuditComponent.defaultContrib</require>
  <require>org.nuxeo.ecm.platform.routing.audit</require>

  <extension target="org.nuxeo.audit.service.AuditComponent" point="routes">
    <route name="default">
      <event name="lwgWorkflowStepCompleted" />
    </route>
  </extension>

  <extension target="org.nuxeo.audit.service.AuditComponent" point="extendedInfo">
    <!-- id of the completed step (rnode:nodeId) -->
    <extendedInfo event="lwgWorkflowStepCompleted" key="nodeId" expression="${message.properties.nodeId}" />
    <!-- positions of the followed transitions in the step (definition order), comma separated, empty for an end step -->
    <extendedInfo event="lwgWorkflowStepCompleted" key="transitions" expression="${message.properties.transitions}" />
  </extension>

</component>
